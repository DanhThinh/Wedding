rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function validText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function validEventIds(ids) {
      return ids is list && ids.size() <= 3
        && ids.hasOnly([1, 2, 3]) && ids.toSet().size() == ids.size();
    }

    function validRsvpV2(data) {
      return data.keys().hasAll(['schemaVersion', 'name', 'phone', 'attending', 'eventIds', 'plusOnes', 'message', 'editToken', 'updatedAt'])
        && data.keys().hasOnly(['schemaVersion', 'name', 'phone', 'attending', 'eventIds', 'plusOnes', 'message', 'editToken', 'updatedAt'])
        && data.schemaVersion == 2
        && validText(data.name, 100)
        && data.phone is string && (data.phone == '' || data.phone.matches('^[0-9]{10,11}$'))
        && data.attending is bool && validEventIds(data.eventIds)
        && data.plusOnes is int && data.plusOnes >= 0 && data.plusOnes <= 10
        && (data.attending ? data.eventIds.size() > 0 : (data.eventIds.size() == 0 && data.plusOnes == 0))
        && data.message is string && data.message.size() <= 500
        && data.editToken is string && data.editToken.matches('^[a-f0-9]{64}$')
        && data.updatedAt == request.time;
    }

    match /wishes/{wishId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'message', 'createdAt'])
        && validText(request.resource.data.name, 80)
        && validText(request.resource.data.message, 500)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /rsvps/{rsvpId} {
      // New shared form. The unguessable edit capability never appears in public links.
      allow create: if rsvpId.matches('^[a-f0-9]{32}$') && validRsvpV2(request.resource.data);
      allow update: if resource.data.schemaVersion == 2
        && validRsvpV2(request.resource.data)
        && request.resource.data.editToken == resource.data.editToken;

      // Retain create compatibility for already-open tabs running the old form.
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'phone', 'eventIds', 'plusOnes', 'createdAt'
        ])
        && validText(request.resource.data.name, 100)
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[0-9]{10,11}$')
        && validEventIds(request.resource.data.eventIds)
        && request.resource.data.eventIds.size() > 0
        && request.resource.data.eventIds.size() <= 3
        && request.resource.data.plusOnes is int
        && request.resource.data.plusOnes >= 0
        && request.resource.data.plusOnes <= 10
        && request.resource.data.createdAt == request.time;
      allow read, delete: if false;
    }

    // Form "Xác Nhận Tham Dự" của giao diện thiệp: có/không + họ tên + lời nhắn.
    match /attendances/{attendanceId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'attending', 'message', 'createdAt'
        ])
        && validText(request.resource.data.name, 100)
        && request.resource.data.attending is bool
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
