# ─── Firebase Config (Guestbook Realtime) ───
# Copy file này thành .env rồi điền thông tin từ Firebase Console
# Nếu KHÔNG điền, guestbook tự động dùng localStorage (vẫn hoạt động)
#
# Lấy tại: Firebase Console → Project Settings → General → Your apps → Web app

# Đường dẫn gốc khi deploy. Local/Firebase/Vercel dùng `/`; GitHub Pages workflow
# tự đặt thành `/Wedding/`.
VITE_BASE_PATH=/
# URL công khai đầy đủ, gồm subpath nếu có; dùng cho preview khi chia sẻ link.
VITE_SITE_URL=https://danhthinh.github.io/Wedding/

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Khuyến nghị: reCAPTCHA v3 site key cho Firebase App Check. Sau khi cấu hình,
# bật enforcement cho Cloud Firestore trong Firebase Console để hạn chế bot.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Thêm file nhạc có bản quyền sử dụng hợp lệ vào public/music/ rồi bật tại đây.
# Để trống nếu chưa có nhạc; ứng dụng sẽ tự ẩn nút phát nhạc.
VITE_BACKGROUND_MUSIC_SRC=
